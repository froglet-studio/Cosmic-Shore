      "TigerMoth": ["Tiger Moth", "Tiger_Moth", "TIGER_MOTH"],
      "BrittleStar": ["Brittle Star", "Brittle_Star", "Brittlestar"],
      "Jacks": ["JACKS"],
      "Orca": ["ORCA_CREW"]
    }
  },
  "shell": [
