{
  "comment": "The swim lanes /swimlanes ranks (swimlanes.py). A lane is a vessel or a section of the app shell someone can hold in their head, never a task. Vessels come from the roster (every Assets/Resources/ElementalAbilityMaps/<Vessel>.asset) and need no entry here; give one an alias when its files use another name. A shell lane is a key, a name, the tokens a file name or folder carries (matched at a word or CamelCase boundary, so 'Ratel' never matches 'generateLattice') and path prefixes. 'verdicts' is where a PERSON says a lane is polished or rough; a verdict beats the measured polish signals and is written with `swimlanes.py set`. Any collaborator may add a lane or a token; a lane that grows too wide (most commits touch it) stops telling people apart, so keep tokens specific.",
  "window_days": 7,
  "landed_days": 14,
  "ignore_branches": ["bugledger", "compute", "compute-queue", "perf-status", "launch-status", "ai", "ci-scratch/", "scratch/", "security/", "build/", "development", "main", "master", "gh-pages"],
  "non_occupants": {
    "dbrutus": "an intern (Garrett, 2026-11-08): their branches never occupy a lane; a fix of theirs goes to the lane's occupant to apply"
  },
  "ignore_subjects": "^(chore\\((ai-learn|compute|perf|launch-status|bug-ledger|bugledger)\\)|Merge |merge:? )",
  "vessels": {
    "retired": ["Butterfly", "Termite", "Falcon"],
    "aliases": {
      "Goby": ["Pistol", "GobyPistol"],
      "Wrasse": ["Grouper", "KiteNavigator", "Kite_Navigator"],
