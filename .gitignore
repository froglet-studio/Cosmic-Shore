# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Bb]in/
/[Ll]ogs/
/[Cc]urrentBuild*/
/[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/
/UserSettings/
/lfs
/hooks

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*
[Aa]ssets/PlayFabEditorExtensions/Editor/Resources/PlayFabEditorPrefsSO*

# Jetbrains configuration directory
.idea/

# Visual Studio cache directory
.vs/

# Visual Studio Code cache directory
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.unitypackage.meta
*.csproj.meta

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.unitypackage
[Cc]urrentBuild*.txt

# Crashlytics generated file
crashlytics-build.properties
/ProjectSettings/BurstAotSettings_StandaloneWindows.json
/Recordings
/Assets/Graphics/Materials/Shaders/DitheringVolumeDisplayShader.shader.meta
/ProjectSettings/BurstAotSettings_StandaloneLinux64.json
/.utmp/
# NOTE: /.editorconfig was ignored here until 2026-08-21. It was removed deliberately -
# a gitignored .editorconfig enforces nothing for anyone else, which defeats its purpose.
# See Docs/ASSEMBLY_SPLIT.md - 'Not enforced automatically'.
Assets/Unity Assests/TextMesh Pro/Examples & Extras/Resources/Fonts & Materials/Electronic Highway Sign SDF.asset

# FMOD runtime/editor logs (regenerated per session, per OS)
fmod_editor.log
fmod_profiler.log
fmod*.log

# FMOD bank-scan cache (auto-regenerated by EventManager.UpdateCache on project open)
Assets/Plugins/FMOD/Cache/Editor/FMODStudioCache.asset
Assets/Plugins/FMOD/Cache/Editor/FMODStudioCache.asset.meta

# Prism explosion A/B benchmark output (branch-independent, regenerated per run)
BenchmarkResults/

# Python bytecode from Tools/CI scripts
__pycache__/
*.pyc
