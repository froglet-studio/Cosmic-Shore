+        static Vector3 SafeClosest(Collider c, Vector3 q, Bounds b)
+        {
+            if (c is BoxCollider || c is SphereCollider || c is CapsuleCollider || (c is MeshCollider m && m.convex)) return c.ClosestPoint(q);
+            return b.ClosestPoint(q);
+        }
+
+        static readonly Collider[] s_beside = new Collider[16];
+
+        /// <summary>The nearest non-own prism surface within <paramref name="r"/> of the hull (own trail spawns there).</summary>
+        static bool Beside(IPlayer p, Vector3 pos, float r, out Vector3 near)
+        {
+            near = default;
+            int n = Physics.OverlapSphereNonAlloc(pos, r, s_beside, s_prismMask, QueryTriggerInteraction.Collide);
+            float best = float.MaxValue; bool any = false;
+            for (int i = 0; i < n; i++)
+            {
+                var c = s_beside[i];
+                if (c == null) continue;
+                var pr = c.GetComponentInParent<Prism>();
+                if (pr != null && !pr.IsEnvironmentOwned && pr.PlayerName == p.Name) continue;
+                Vector3 cp = SafeClosest(c, pos, c.bounds);
+                float d = (cp - pos).sqrMagnitude;
+                if (d < 0.01f || d >= best) continue;
+                best = d; near = cp; any = true;
+            }
+            return any;
+        }
+
+        static readonly Vector3[] s_esc = new Vector3[6];
+
+        /// <summary>The escape the sweep proposes if it is clear, else the clearest of a few around the travel line.</summary>
+        static Vector3 ClearEscape(Vector3 pos, Vector3 dir, float radius, float limit, Vector3 proposed)
+        {
+            float len = Mathf.Max(limit * 0.7f, 15f);
+            if (!Sweep(pos, proposed, radius, len, out float bestD, out _, out _)) return proposed;
+            Vector3 best = proposed;
+            Vector3 a = Vector3.Cross(dir, Mathf.Abs(Vector3.Dot(dir, Vector3.up)) > 0.9f ? Vector3.right : Vector3.up).normalized;
+            Vector3 b = Vector3.Cross(dir, a);
+            for (int k = 0; k < 6; k++)
+            {
+                float az = k * Mathf.PI / 3f;
+                Vector3 cand = (dir * 0.5f + (a * Mathf.Cos(az) + b * Mathf.Sin(az)) * 0.85f).normalized;
+                if (!Sweep(pos, cand, radius, len, out float d, out _, out _)) return cand;
+                if (d > bestD) { bestD = d; best = cand; }
+            }
+            return best;
+        }
