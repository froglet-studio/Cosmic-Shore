<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the SHIPPED Charge light core (ChargeArcs.cs) against the omni turns harness's UnityStub.cs and checks it
       on the real Charge crystal and omni meshes (dump.py). Nothing under Assets/ is copied or edited. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS8981;CS0162;CS1591;CS0660;CS0661;CS0414;CS0649</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../omni_turns_harness/UnityStub.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="../../../Assets/_Scripts/Utility/ChargeArcs.cs" />
  </ItemGroup>
</Project>
