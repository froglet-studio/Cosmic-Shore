<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the SHIPPED converter round-5 pieces (OmniCombineCore's game-motion path and CrystalFrame, SquareTurnFit, the
       cadence, the Charge light core) on the shipped OmniCombineData.json, against the omni turns harness's UnityStub.cs.
       Nothing under Assets/ is copied or edited. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS8981;CS0162;CS1591;CS0660;CS0661;CS0414;CS0649</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../omni_turns_harness/UnityStub.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="../../../Assets/_Scripts/Utility/OmniCombineCore.cs" />
    <Compile Include="../../../Assets/_Scripts/Utility/OmniCadence.cs" />
    <Compile Include="../../../Assets/_Scripts/Utility/SquareTurnFit.cs" />
    <Compile Include="../../../Assets/_Scripts/Utility/ChargeArcs.cs" />
    <Compile Include="../../../Assets/_Scripts/Utility/OmniCombineMotion.cs" />
  </ItemGroup>
</Project>
