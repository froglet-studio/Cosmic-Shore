<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by Tools/Build/prisma_edit_mode_tests/run.sh into a temp folder. Do not commit a
       copy: @WT@ / @PROJ@ / @LIVE_REL@ are filled per run. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Assets/_Scripts/AssemblyInfo.cs grants InternalsVisibleTo("Assembly-CSharp-Editor"),
         which is how Unity's edit-mode tests reach internal members. -->
    <AssemblyName>Assembly-CSharp-Editor</AssemblyName>
    <DefineConstants>$(DefineConstants);UNITY_EDITOR;UNITY_INCLUDE_TESTS</DefineConstants>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS0618;CS0162;CS0219</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LiveAssetsDir>@PROJ@/src</LiveAssetsDir>
    <!-- The sync task writes to $(MSBuildThisFileDirectory)$(LiveSrcDir) of ITS file, so this is
         relative to Port/src/CosmicShore.Live and lands back in this project. -->
    <LiveSrcDir>@LIVE_REL@</LiveSrcDir>
  </PropertyGroup>
  <!-- The port's own source rewrite (UnityEngine -> CosmicShore.Engine, RPC interception ...), so
       the tests compile exactly the way the game's scripts do. -->
  <Import Project="@WT@/Port/src/CosmicShore.Live/SyncUnitySources.targets" />
  <PropertyGroup>
    <LiveScriptRoots>mp</LiveScriptRoots>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="shim/**/*.cs" />
    <Compile Include="obj/live-tests/**/*.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="@WT@/Port/src/CosmicShore.Engine/CosmicShore.Engine.csproj" />
    <ProjectReference Include="@WT@/Port/src/CosmicShore.Compat/CosmicShore.Compat.csproj" />
    <ProjectReference Include="@WT@/Port/src/CosmicShore.Live/CosmicShore.Live.csproj" />
    <ProjectReference Include="@WT@/Port/src/CosmicShore.Content/CosmicShore.Content.csproj" />
  </ItemGroup>
</Project>
