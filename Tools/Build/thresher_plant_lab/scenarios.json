{
  "_comment": "Scripted plant cycles for the parity gate (parity.cjs). Each step runs for t seconds at a constant yaw (deg/s) and winch state; plant/release/arm fire on the step's first frame. Run by TraceDriver.cs against the SHIPPED ThresherChainSolver and by the lab page's own JS port.",
  "scenarios": [
    { "name": "reeled-turn-plant", "steps": [
      { "t": 1.0, "yaw": 0, "pay": false },
      { "t": 0.6, "yaw": 60, "pay": false },
      { "t": 2.0, "yaw": 0, "pay": false, "plant": true },
      { "t": 2.0, "yaw": 0, "pay": false, "release": true } ] },
    { "name": "letout-plant-reel-spin", "steps": [
      { "t": 1.0, "yaw": 0, "pay": true },
      { "t": 0.8, "yaw": -30, "pay": true },
      { "t": 0.8, "yaw": 0, "pay": true, "plant": true },
      { "t": 1.2, "yaw": 0, "pay": false },
      { "t": 1.5, "yaw": 0, "pay": false, "release": true } ] },
    { "name": "straight-plant-degenerate", "steps": [
      { "t": 0.5, "yaw": 0, "pay": false },
      { "t": 2.0, "yaw": 0, "pay": false, "plant": true },
      { "t": 1.0, "yaw": 0, "pay": false, "release": true } ] },
    { "name": "armed-launch", "steps": [
      { "t": 1.0, "yaw": 0, "pay": false },
      { "t": 0.5, "yaw": 90, "pay": false },
      { "t": 1.5, "yaw": 0, "pay": false, "plant": true },
      { "t": 3.0, "yaw": 0, "pay": false, "arm": [1, 0, 0] } ] }
  ]
}
