    - Id: job.courier.dispatch
      Kind: 0
      Faction: 1
      Needs: 0
      Goes: 1
      Title: '{pilot}: carry a sealed dispatch to {to}'
      Summary: 'Reach {to} with the Ark standing. The news aboard will change what {to} knows.'
      SuccessLine: '{pilot}''s dispatch reached {to}. The dock crews were talking about it before the hull cooled.'
      FailLine: 'The dispatch for {to} never arrived.'
      SuccessLines:
      - '{pilot}''s dispatch reached {to}. The dock crews were talking about it before the hull cooled.'
      - '{to} has {pilot}''s dispatch. Three ledgers were rewritten before the Ark was tied up.'
      - '{pilot} came into {to} with the dispatch sealed and left with it read. News travels on Arks.'
      FailLines:
      - 'The dispatch for {to} never arrived.'
      - '{to} waited for {pilot}''s dispatch and got rumours instead.'
      Reward: 6
      RewardElement: 4
      OnSuccess: ev.courier.delivered
      OnFail: 
      Verb: 0
      Goal: 0
      HullFloor: 0
      NoKill: 0
      Role: 0
      Tier: 0
      StandingDelta: 1
      NotorietyDelta: 0
      GoesUncharted: 0
      AvoidsOwnDomain: 0
      RivalsMayTake: 1
      ChronicleLine: 'Carried a dispatch to {to}.'
    - Id: job.convoy.contract
      Kind: 17
      Faction: 1
      Needs: 15
      Goes: 1
      Title: '{pilot}: run cargo through to {to}'
      Summary: '{to} is cut off and paying cargo rates. Bring the Ark in with more than half its hull.'
      SuccessLine: '{pilot} brought the cargo into {to} with the hull holding. The quay paid in full.'
      FailLine: 'The cargo for {to} came in short, or not at all.'
      SuccessLines:
      - '{pilot} brought the cargo into {to} with the hull holding. The quay paid in full.'
      - 'The convoy made {to}. {pilot} counted the plates left and called it a profit.'
      FailLines:
      - 'The cargo for {to} came in short, or not at all.'
      - '{to} got half a hold and paid for none of it.'
      Reward: 10
      RewardElement: 2
      OnSuccess: ev.convoy.delivered
      OnFail: 
      Verb: 0
      Goal: 0
      HullFloor: 0.6
      NoKill: 0
      Role: 1
      Tier: 0
      StandingDelta: 1
      NotorietyDelta: 0
      GoesUncharted: 0
      AvoidsOwnDomain: 0
      RivalsMayTake: 1
      ChronicleLine: 'Ran a convoy through to {to}.'
    - Id: job.hunt.sighting
      Kind: 1
      Faction: 2
      Needs: 1
      Goes: 2
      Title: '{pilot}: open the vaults at {to}'
      Summary: 'Vaults are lit at {to}. Crack one with a payload, carry its artifact back to the Ark and stow it.'
      SuccessLine: '{pilot}''s crew opened a vault at {to}. Its chart pointed somewhere new.'
