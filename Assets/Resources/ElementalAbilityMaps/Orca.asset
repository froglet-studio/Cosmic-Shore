%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b3f2a8c8f344355b16a4d4296ae3f98, type: 3}
  m_Name: Orca
  m_EditorClassIdentifier:
  vesselClass: 20
  entries:
  - Element: 1
    AbilityLabel: 'Flown Missiles'
    AbilityDescription: 'Each gunner launches missiles from its own magazine and flies them by hand; Charge makes them faster and sharper. An omni crystal gives every gunner a missile. The card counts your missiles.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Rearm'
    UpgradeDescription: 'Every gunner''s magazine regains a missile every 12 seconds, up to its size, so the crew never runs dry between omni crystals. Gated on IsUpgradeActive(Charge).'
  - Element: 3
    AbilityLabel: 'Burst'
    AbilityDescription: 'A missile bursts on contact, after five seconds, or when its gunner presses Missile again, and the third gunner''s bomb bursts the same way; Space widens both blasts. The card flashes on every burst.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Chain Burst'
    UpgradeDescription: 'A missile or bomb burst sets off every other missile of your crew, and its bomb, inside its blast. Gated on IsUpgradeActive(Space).'
  - Element: 2
    AbilityLabel: 'Danger Shield'
    AbilityDescription: 'The helm rings the hull in super-shielded prisms, open ahead, on the left trigger; they ride with the hull, then drop where they are as danger prisms. Mass carries the ring longer. The card shows its recharge.'
    Input: 2
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Bulwark'
    UpgradeDescription: 'The shield is laid twice, a second shell 14 u further out, so the wall the helm carries is twice as thick. Gated on IsUpgradeActive(Mass).'
  - Element: 4
    AbilityLabel: 'Boost Tank'
    AbilityDescription: 'The helm boosts on the right trigger while the tank lasts; it refills on its own, faster with Time. The card shows the tank.'
    Input: 1
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Afterburner'
    UpgradeDescription: 'The tank keeps refilling while the helm burns, so a burn lasts longer and an empty tank recovers under a held trigger. Gated on IsUpgradeActive(Time).'
