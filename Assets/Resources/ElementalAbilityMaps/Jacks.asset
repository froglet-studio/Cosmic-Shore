%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b3f2a8c8f344355b16a4d4296ae3f98, type: 3}
  m_Name: Jacks
  m_EditorClassIdentifier:
  vesselClass: 22
  entries:
  - Element: 1
    AbilityLabel: 'Danger Share'
    AbilityDescription: 'Charge sets the share of the herd that is DANGER: none at -5, all of it at 15. A danger creature that touches a rival hull stings it (a Strike) and is spent.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Attack'
    UpgradeDescription: 'The herd goes for rivals near it and bites any it touches.'
  - Element: 2
    AbilityLabel: 'Breeding'
    AbilityDescription: 'Mass sets how fast the herd breeds: a birth takes the species'' own feeds at -5 and a third of them at 15. The herd never starves below its minimum size.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Mass Clusters'
    UpgradeDescription: 'Every few seconds a creature of the herd lays a cluster of your mass.'
  - Element: 3
    AbilityLabel: 'Herding Ring'
    AbilityDescription: 'Space widens the ring both jacks and the decoy push the herd out of; it is never smaller than a big thumb.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Eat Shields'
    UpgradeDescription: 'The herd eats shielded prisms.'
  - Element: 4
    AbilityLabel: 'Herd Speed'
    AbilityDescription: 'Time sets how fast the herd swims. The call (B): herding, it pulls the herd between the jacks for a moment, on a long cooldown; netting, it turns the herd''s pull to your plane on and off.'
    Input: 7
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Flying Decoy'
    UpgradeDescription: 'Netting, the jacks drop the decoy where they are (A), so they can jump back to it.'
