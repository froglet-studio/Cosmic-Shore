  m_Script: {fileID: 11500000, guid: 4b3f2a8c8f344355b16a4d4296ae3f98, type: 3}
  m_Name: Goby
  m_EditorClassIdentifier:
  vesselClass: 18
  entries:
  - Element: 1
    AbilityLabel: 'Vortex Sting'
    AbilityDescription: 'A vortex ring from the Pistol''s Snap that hits a rival hull takes petals from each of its elements; Charge raises how many (GobyPistolConfig ringPetals, 1 at rest -> 3 at level 10). While the Goby holds a lock on a rival that is on the Pistol''s screen, the ring flies at it.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: ''
    UpgradeDescription: ''
  - Element: 2
    AbilityLabel: 'Dens'
    AbilityDescription: 'At each perch the Pistol rests and builds a den of prisms and shielded prisms, as many as the distance it travelled since its last den and Mass make (denMassScale, x1 at rest -> x2.5 at level 10). It can ride back to an old den to add to it.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Fortress'
    UpgradeDescription: 'Dens also grow danger prisms and super-shielded prisms.'
  - Element: 3
    AbilityLabel: 'Undertow'
    AbilityDescription: 'Mass either side of the Pistol''s plane is pulled into it, from further with Space (pullReach, 40 u at rest -> 200 u at level 10). Danger, super-shielded and the pair''s own prisms never move.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Deep Undertow'
    UpgradeDescription: 'Shielded prisms are pulled in too.'
  - Element: 4
    AbilityLabel: 'Quick Jump'
    AbilityDescription: 'Time shortens the cooldown of the Pistol''s jump, the burst of speed that flings it off its ground (jumpCooldown, 9 s at rest -> 3 s at level 10).'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 'Phase Dart'
    UpgradeDescription: 'The Goby''s darts pass through prisms.'
