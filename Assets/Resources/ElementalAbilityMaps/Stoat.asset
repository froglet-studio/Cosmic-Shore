%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4b3f2a8c8f344355b16a4d4296ae3f98, type: 3}
  m_Name: Stoat
  m_EditorClassIdentifier:
  vesselClass: 15
  entries:
  - Element: 3
    AbilityLabel: Catch Orbit
    AbilityDescription: 'Triggers: LT on the left, RT on the right. A press lays a small black hole
      ahead of you on the pressed side. Fly past beside it and it SWINGS you round toward
      itself until you have turned the angle your stick asks - toward the hole the most,
      away from it the least, at rest the middle - then lets you go on that heading,
      keeping the swing''s speed. Let go of the trigger mid-swing
      to leave at once. Passed or out of time, the hole collapses and throws the Charge
      ripple. A hole you own never pulls you in. Space is the swing''s reach - one dial, read
      live: x1 -> x1.4 at level 10 (StoatSlingConfigSO.orbitReach). R_VesselActions/STOAT_DIPOLE.md
      section 1b.'
    Input: 2
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: Accretion
    UpgradeDescription: 'While your swing''s black hole is up, rival prisms that fall into it are STOLEN
      (yours), and each one adds 4% to the reach of the ripple it throws, up to +40%
      (StoatSlingConfigSO.accretionPerPrism / accretionMax).'
  - Element: 4
    AbilityLabel: Timed Slingshot
    AbilityDescription: 'Passive speed. While your swing''s black hole is up your flight clock warps and you
      fly faster: half of it from the press, all of it and 15% more while the swing turns you,
      and the swing''s warp kept as momentum after it lets you go, fading over 6 s. Time is
      rate - one dial, the Stoat''s warp: x2.7 at rest -> x5.6 at level 10 (StoatDipoleConfigSO.boost
      x StoatSlingConfigSO.catchWarpShare).'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: 
    UpgradeDescription: 'Open: Foresight (the rivals'' predicted paths, drawn with the old field pathfinder)
      was deleted on 2026-11-21 with that pathfinder, and the Stoat draws nothing since 2026-11-22.
      Time 5 has no upgrade until one is designed.'
  - Element: 1
    AbilityLabel: Ripple
    AbilityDescription: 'Passive, anti-vessel and anti-creature. Every black hole of yours that collapses - a
      swing''s hole passed, let go or out of time - throws a SPACE-TIME
      RIPPLE from where the hole was: a spherical wave that bends the scene as it passes.
      Where its front sweeps over them, rival vessels are STRIPPED of one whole petal of
      every element they hold (shed as crystals around them; a ward against blasts stops
      it) and creatures are killed. It touches no prism, and never you or a teammate. The
      ripple''s reach is the swing''s ripple separation x0.6 (StoatSlingConfigSO.rippleSeparation)
      - Charge scales it x1 -> x2 at level 10 (StoatRippleConfigSO.reach, replicated
      level).'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: Siphon
    UpgradeDescription: 'The petals the ripple strips come straight to YOU instead of being shed as crystals
      - a rival''s level becomes yours. Gated on IsUpgradeActive(Charge), replicated, so
      every peer moves the same petals (StoatRippleConfigSO.siphonOnChargeUpgrade).'
  - Element: 2
    AbilityLabel: Heavy Launch
    AbilityDescription: 'Passive. Mass powers a second push as the swing lets you go - one dial, read live:
      x1 at rest -> x2.5 at level 10 (StoatSlingConfigSO.launchPower). The push ships OFF
      (swingKickShare 0, 2026-11-19: one slingshot, the swing''s own speed-up), so only
      Armoured Wake acts until it is turned back on.'
    Input: 0
    UnlockLevel: 5
    RelockBelowLevel: 4
    LatchPolicy: 0
    UpgradeLabel: Armoured Wake
    UpgradeDescription: 'The prisms you lay while a launch''s kick lasts (1.5 s) arrive SHIELDED. Gated on
      IsUpgradeActive(Mass), replicated: every peer runs the replicated release, so every peer
      lays the same tier (StoatSlingConfigSO.massUpgradeShieldsLaunchTrail).'
  omniAbilityLabel: Fulmen
