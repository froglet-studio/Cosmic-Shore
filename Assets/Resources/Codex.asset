  tools:
  - Id: tool.domain-changer
    Kingdom: 3
    DisplayName: Domain Changer
    Tagline: Fly through to change your team colour.
    Description: 
    Image: {fileID: 21300000, guid: 5efd3da02cf9dfd4295b08dd839f741c, type: 3}
    SourcePrefab: {fileID: 0}
    SourceConfig: {fileID: 11400000, guid: 4c1c78b17b430f7489c9bc1697aac444, type: 2}
    AccentColor: {r: 0.85, g: 0.3, b: 0.9, a: 1}
    UnlockedByDefault: 1
    DiscoveryKey: use.tool.domain-changer
    PreviewYaw: -28
    PreviewPitch: 16
    PreviewPadding: 1.05
    FlatSilhouette: 0
    Group: "1 \xB7 Pilot"
    SortOrder: 0
    LockAutoHarvest: 0
    Stats:
    - Label: Kind
      Value: "Pilot \u2014 it changes YOU. The hull you fly or the colours you wear;
        the world is exactly where you left it"
      Authored: 0
    - Label: Activation
      Value: "Fly your vessel through its ring \u2014 the ring IS the trigger volume,
        drawn at its own radius, so what you can see is what you can cross"
      Authored: 0
    - Label: Objective
      Value: "None. A tool has no score, no end condition and nothing on a clock
        \u2014 it is a thing to play with for as long as you like"
      Authored: 0
    - Label: In your toybox
      Value: "Yes \u2014 unlocked from the start"
      Authored: 0
    - Label: Found at
      Value: "Out by the cell membrane, at 240\xB0 around the cell"
      Authored: 0
    - Label: Form
      Value: "A flip-set \u2014 one station per colour you are NOT, and using one
        flips it to the colour you just left"
      Authored: 0
    - Label: Offers
      Value: "3 domains, 2 stations \u2014 the colours you are not"
      Authored: 0
    - Label: Authority
      Value: Server-side. The change replicates to every peer, so the whole party
        sees it
      Authored: 0
    - Label: What it does not change
      Value: Mass you have already laid. A prism keeps the colour it was laid in,
        so changing domain leaves your old trail behind as another team's
      Authored: 0
