  m_Script: {fileID: 11500000, guid: ee31201c5376a4785c0599616b1ed33c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  vessels: {fileID: 11400000, guid: 17dcd58a38dad2a498afe518e6a0bb58, type: 2}
  roster: {fileID: 11400000, guid: 6b3d92c47ae14f08b5c1e0d7f3a2958c, type: 2}
  elementShapes:
  - {fileID: 21300000, guid: cbac2ac9cd6900044b197490af5727f1, type: 3}
  - {fileID: 21300000, guid: 1eb2c03794f55824d8e01e96c4fe7a3e, type: 3}
  - {fileID: 21300000, guid: 4e788082740141a45b47f1c51a5c15b0, type: 3}
  - {fileID: 21300000, guid: 809450069823742448227b7dceef6fcc, type: 3}
  elementFlipbooks:
  - {fileID: 2800000, guid: 020e9c8fcbcd4e44995fa49d0712b078, type: 3}
  - {fileID: 2800000, guid: a82c3277cc8d45d1b9bfb211acfd06e5, type: 3}
  - {fileID: 2800000, guid: 54ce7ba5d021482a950540e57c8f4283, type: 3}
  - {fileID: 2800000, guid: ffc77f16fb7e42d38d229aa1081a45a5, type: 3}
  colorSet: {fileID: 11400000, guid: 8d1c1bdcb636a424d9c54fbd1afc952f, type: 2}
  words:
    elementNames:
    - Charge
    - Mass
    - Space
    - Time
    elementLines:
    - The strike you carry
    - What you build
    - How far you reach
    - How fast you move
    elementGameplay: Skim {element} Etherions or fly the Element Charger to raise it. Its ability wakes at level 5, and so does the hull's level-5 upgrade.
    elementLore:
    - The spark of the HyperSea. Where it gathers, things strike.
    - The weight of the HyperSea. Everything that stands is made of it.
    - The reach of the HyperSea. It decides how far anything goes.
    - The pulse of the HyperSea. It sets how fast anything moves.
    elementKicker: Element
    elementRowsHeading: On every vessel
    elementRowTemplate: '{ability} - level 5: {upgrade}'
    elementRowNoUpgrade: '{ability}'
    openSlot: Open slot
    elementCards:
    - title: Omni
      sub: Every element at once
      kicker: Etherion
      gameplay: 'Free to every pilot, whatever their domain: fly into it. Modes score it, and hulls spend it: the Dolphin''s blast, the Sparrow''s missile reload, the Scarab''s ball forge. In the Ark, Charge, Mass, Space and Time combine into one.'
      lore: Where all four meet, the crystal belongs to no one.
      image: {fileID: 21300000, guid: b592d632483050e40a6cf3d3240f2a92, type: 3}
      flipbook: {fileID: 2800000, guid: 011597876c53412eab22e8232d0d250f, type: 3}
    - title: Prisms
      sub: What the HyperSea is built from
      kicker: Matter
      gameplay: Every vessel lays a trail of prisms as it flies. Trails, walls and every plant are made of prisms, and fauna feed on them.
      lore: 
      image: {fileID: 21300000, guid: 867af69bf95f4e19bda99bbfde6fcde5, type: 3}
      flipbook: {fileID: 0}
    - title: Spindles
      sub: What plants grow along
      kicker: Matter
      gameplay: The branches a plant grows along. Each spindle carries its prisms out from the plant's heart, so a plant's shape is the shape of its spindles.
      lore: 
      image: {fileID: 21300000, guid: d54baa24ff3f9f544b6187fba8bcda8c, type: 3}
      flipbook: {fileID: 0}
    floraKicker: Flora
    faunaKicker: Fauna
    factsHeading: Facts
    cellsHeading: By element
    cellLineTemplate: '{label}: {value}'
    cellLines: 3
    lawsHeading: Elemental laws
    loreHeading: Lore
    lexicon:
    - title: Arcade
      sub: Quick games
      kicker: Lexicon
      gameplay: 'Short games for one to four pilots: races, hunts, duels and building. Pick a game, set its intensity and seats, and launch. Favourites sit at the top; filter by element or vessel.'
      lore: 
      image: {fileID: 21300000, guid: 66bebfc371fe47409acb7f4939ab58b0, type: 3}
      flipbook: {fileID: 0}
    - title: Quests
      sub: One goal at a time
      kicker: Lexicon
      gameplay: An episode is a line of quests. Each names a game and what to do in it; claim it and the next one opens. Episode 1 is The Hypersea. Follow them from the Voyage window.
      lore: 
      image: {fileID: 21300000, guid: dc75ad1ec5baa7cee48c2bdae6c2422f, type: 3}
      flipbook: {fileID: 0}
    - title: Voyages
      sub: Journeys beyond the cell
      kicker: Lexicon
      gameplay: Long journeys out of the cell, through a corridor of new ones. Open the Voyage window from Home and set sail. Tandava is the first.
      lore: 
      image: {fileID: 21300000, guid: a797820482af42d4a6eb9a4b7426539b, type: 3}
      flipbook: {fileID: 0}
    - title: Missions
      sub: Games with a story
      kicker: Lexicon
      gameplay: 'Their own games, apart from the Arcade: a goal to protect or reach against the HyperSea. Not open yet.'
      lore: 
      image: {fileID: 21300000, guid: 78575ccdc916fca45960791606e128c9, type: 3}
      flipbook: {fileID: 0}
    - title: Vessels
      sub: The hulls you fly
      kicker: Lexicon
      gameplay: Each vessel is a hull with four abilities, one for each element. Raise an element to level 5 to wake its ability and the hull's level-5 upgrade. Choose and upgrade vessels in the Hangar.
      lore: 
      image: {fileID: 21300000, guid: f284e1a9bdef6804a99ce9e48bfa89cd, type: 3}
      flipbook: {fileID: 0}
    - title: Pilots
      sub: Who flies them
      kicker: Lexicon
      gameplay: Every vessel has a pilot for each element, each with a signature and a style of flying. Meet them in the Hangar's PILOTS tab.
      lore: 
      image: {fileID: 21300000, guid: 516d19e9db897c14aa1698abb25cbe32, type: 3}
      flipbook: {fileID: 0}
    - title: Artifacts
      sub: Found far out
      kicker: Lexicon
      gameplay: Artifacts are found far out in the HyperSea. None found yet.
      lore: 
      image: {fileID: 21300000, guid: e630252a051ab50d162f4378bb94972b, type: 3}
      flipbook: {fileID: 0}
    - title: Toys
      sub: The Toy Box
      kicker: Lexicon
      gameplay: Stations out by the cell membrane. Fly through one to change your domain, swap your vessel, charge your elements, release lifeforms or go wandering. A toy has no score and no clock.
      lore: 
      image: {fileID: 21300000, guid: 601651507d53ea4408ef4abcaf486d2b, type: 3}
      flipbook: {fileID: 0}
  stopTitles:
  - Elements
  - Flora
  - Fauna
  - Lexicon
