%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 79d74610f2f76d8490f723479967fcce, type: 3}
  m_Name: StarlingCardDeck
  m_EditorClassIdentifier: 
  revision: 3
  cards:
  - id: mass-mound-builders
    element: 2
    displayName: 'Mound Builders'
    kind: 'Build'
    shinesIn: 'Any'
    text: 'The swarm lays your team''s prisms along its path.'
    stats:
    - label: 'Prisms laid'
      kind: 0
      a: 0.5
      b: 0.25
      unit: '/s'
      decimals: 2
      steps: []
    milestones:
    - level: 5
      text: 'Laid prisms join into a solid wall with no gaps'
    - level: 15
      text: 'Laid prisms are shielded'
    wired: 1
  - id: mass-danger-drip
    element: 2
    displayName: 'Danger Drip'
    kind: 'Build'
    shinesIn: 'Opposing vessels'
    text: 'Members drip danger prisms behind them. A rival that flies through one is slowed and loses a petal, as any danger prism does.'
    stats:
    - label: 'Danger prisms'
      kind: 0
      a: 0.3
      b: 0.15
      unit: '/s'
      decimals: 2
      steps: []
    milestones:
    - level: 10
      text: 'Drips fall in short lines across the swarm''s wake'
    wired: 1
  - id: mass-conservation-of-mass
    element: 2
    displayName: 'Conservation of Mass'
    kind: 'Build'
    shinesIn: 'Any'
    text: 'Mass is never lost. A member that dies becomes your prisms where it fell.'
    stats:
    - label: 'Prisms per death'
      kind: 0
      a: 1
      b: 0.5
      unit: ''
      decimals: 0
      steps: []
    milestones:
    - level: 10
      text: 'The prisms are shielded'
    wired: 0
  - id: mass-inertial-wall
    element: 2
    displayName: 'Inertial Wall'
    kind: 'Build'
    shinesIn: 'Opposing vessels'
    text: 'Every few seconds the swarm drops a straight wall of your prisms along its line of travel. The faster it flies, the longer the wall, because momentum carries the bricks.'
    stats:
    - label: 'Wall length at cruise'
      kind: 0
      a: 4
      b: 1
      unit: ' prisms'
      decimals: 0
      steps: []
    - label: 'Every'
      kind: 1
      a: 10
      b: 0.95
      unit: 's'
      decimals: 1
      steps: []
    milestones:
    - level: 10
      text: 'The wall is laid as danger prisms'
    wired: 0
  - id: mass-accretion-disk
    element: 2
    displayName: 'Accretion Disk'
    kind: 'Build'
    shinesIn: 'Omnicrystal'
    text: 'Members circling the objective lay a ring of your prisms round it, the way matter collects in orbit round a heavy body.'
    stats:
    - label: 'Ring size'
      kind: 0
      a: 8
      b: 2
      unit: ' prisms'
      decimals: 0
      steps: []
    - label: 'Build time'
      kind: 1
      a: 4
      b: 0.9
      unit: 's'
      decimals: 1
      steps: []
    milestones:
    - level: 10
      text: 'The ring is shielded'
    - level: 15
      text: 'The ring is supershielded'
    wired: 0
  - id: mass-snowball
    element: 2
    displayName: 'Snowball'
    kind: 'Form'
    shinesIn: 'Any'
    text: 'Every 20 s the swarm rolls into one ball. It packs on a layer of your prisms each second, and when it breaks they land as a mound.'
    stats:
    - label: 'Ball lasts'
      kind: 0
      a: 3
      b: 0.5
      unit: 's'
      decimals: 1
      steps: []
