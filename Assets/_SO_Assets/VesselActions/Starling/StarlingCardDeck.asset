      a: 2
      b: 1
      unit: ''
      decimals: 0
      steps: []
    milestones:
    - level: 10
      text: 'The mound lands shielded'
    wired: 1
  - id: mass-density
    element: 2
    displayName: 'Density'
    kind: 'Build'
    shinesIn: 'Any'
    text: 'Your prisms laid close together compress into fewer, bigger prisms, so the same mass holds more volume and takes more to break.'
    stats:
    - label: 'Merge radius'
      kind: 0
      a: 10
      b: 3
      unit: 'u'
      decimals: 0
