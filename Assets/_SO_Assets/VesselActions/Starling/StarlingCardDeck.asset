    wired: 0
  - id: mass-neutron-star
    element: 2
    displayName: 'Neutron Star'
    kind: 'Form'
    shinesIn: 'Any'
    text: 'Every 30 s the swarm crushes into one dense star that cannot be hurt. When it ends it leaves a supershielded core of your prisms.'
