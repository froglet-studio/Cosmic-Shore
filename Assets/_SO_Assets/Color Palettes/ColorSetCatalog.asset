    - Mint over Bronze
    - Orchid over Petrol
    - Bumblebee over Indigo
    - Azure over Forest
    vision: 0
  - id: contrast
    colorSet: {fileID: 11400000, guid: a2b69fd4235d40b683d21c958716a7f8, type: 2}
    displayName: Contrast
    line: 'Every domain as far from every other as the rules allow, for anyone who wants the board to read at a glance.'
    unlocked: 1
    pigments:
    - Sky Cyan over Aubergine
    - Magenta over Viridian
    - Marigold over Electric Violet
    - Ultramarine over Ink
    vision: 6
  - id: protanopia
    colorSet: {fileID: 11400000, guid: 31cde80f4f78432bac8960d826595421, type: 2}
    displayName: Protanopia
    line: 'Made for eyes without red cones (protanopia and protanomaly): the domains told apart on blue-yellow and light.'
    unlocked: 1
    pigments:
    - Aqua over Rust
    - Violet over Ink
    - Tangerine over Steel Blue
    - Lavender over Emerald
    vision: 1
  - id: deuteranopia
    colorSet: {fileID: 11400000, guid: c60912e872a449699ac1e217150b1eeb, type: 2}
    displayName: Deuteranopia
    line: 'Made for eyes without green cones (deuteranopia and deuteranomaly): the domains told apart on blue-yellow and light.'
