  - id: tritanopia
    colorSet: {fileID: 11400000, guid: 744330f0b8aa4ef1a9adcdd29ad77dda, type: 2}
    displayName: Tritanopia
    line: 'Made for eyes without blue cones (tritanopia): the domains told apart on red-teal and light.'
    unlocked: 1
    pigments:
