  - id: achromatopsia
    colorSet: {fileID: 11400000, guid: dfa527e6fbe540f5bac81322305c848f, type: 2}
    displayName: Achromatopsia
    line: 'Made for eyes that see no colour: every domain has its own brightness, rim and face.'
