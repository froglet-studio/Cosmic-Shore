<Project Sdk="Microsoft.NET.Sdk">

  <!-- The port's renderer: draws the engine's scene + uGUI the way the Unity build's
       URP does (linear color space, sRGB textures, stencil masks, HDR + post).
       Backend: OpenGL 3.3 core through Silk.NET (MIT). -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CosmicShore.Engine/CosmicShore.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
  </ItemGroup>

</Project>
