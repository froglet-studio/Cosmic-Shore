<Project Sdk="Microsoft.NET.Sdk">

  <!-- The phone player (Unity's Android/iOS player). Built by `cs-build android|ios`, which
       passes the Player Settings and the packaged player data in as properties:

         CsPlayerData    folder of player data (iOS: shipped inside the bundle as Data/)
         CsDataPak       data.pak + data.hash folder (Android: APK assets, unpacked on first launch)
         CsFmodRoot      Assets/Plugins/FMOD/platforms (the FMOD runtime the project ships)

       The game itself is the same CosmicShore.Live + engine the desktop player runs; only the
       window (an SDL GL ES view), the input (touch) and where the data lives differ. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- iOS needs Apple's toolchain; the workload only installs on macOS (Unity's iOS build is the same). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0-android;net10.0-ios</TargetFrameworks>
    <!-- cs-build narrows the list to the one platform it builds (CsPlatform=android|ios), so a Mac
         CI runner needs only that platform's workload. A property only this project reads: a
         global TargetFrameworks would also retarget the referenced net10.0 libraries. -->
    <TargetFrameworks Condition="'$(CsPlatform)' != ''">net10.0-$(CsPlatform)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>CosmicShore.Mobile</RootNamespace>
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
    <AssemblyName>CosmicShore</AssemblyName>

    <ApplicationTitle Condition="'$(ApplicationTitle)' == ''">Cosmic Shore</ApplicationTitle>
    <ApplicationId Condition="'$(ApplicationId)' == ''">com.FrogletGames.CosmicShore</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>

    <!-- The game reflects over its own types (scene loading binds serialized fields and
         components by name), so nothing is trimmed away: what Unity calls "Strip Engine
         Code: off". Android says so with PublishTrimmed=false; iOS requires the trimmer to
         run and says it with MtouchLink=None (below). -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <NoWarn>$(NoWarn);CA1416;XA4211;XA1006</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
    <SupportedOSPlatformVersion>28</SupportedOSPlatformVersion>
    <AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == ''">apk</AndroidPackageFormat>
    <RuntimeIdentifiers Condition="'$(CsAbis)' != ''">$(CsAbis)</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == '' and '$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <AndroidLinkMode>None</AndroidLinkMode>
    <!-- AOT needs trimming on Android; the game runs JIT-compiled (Mono) instead. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Packaged media is already compressed; the data archive is read once, uncompressed is faster. -->
    <AndroidStoreUncompressedFileExtensions>.pak</AndroidStoreUncompressedFileExtensions>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Name and icon from Player Settings (cs-build passes them); the manifest reads the placeholders. -->
    <CsIconRes>@android:drawable/sym_def_app_icon</CsIconRes>
    <CsIconRes Condition="'$(CsAppIcon)' != ''">@mipmap/appicon</CsIconRes>
    <AndroidManifestPlaceholders>csTitle=$(ApplicationTitle);csIcon=$(CsIconRes)</AndroidManifestPlaceholders>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
    <!-- iOS forbids JIT: AOT what can be, interpret the reflection-driven rest. -->
    <UseInterpreter>true</UseInterpreter>
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CosmicShore.Engine/CosmicShore.Engine.csproj" />
    <ProjectReference Include="../CosmicShore.Compat/CosmicShore.Compat.csproj" />
    <ProjectReference Include="../CosmicShore.Live/CosmicShore.Live.csproj" />
    <ProjectReference Include="../CosmicShore.Content/CosmicShore.Content.csproj" />
    <ProjectReference Include="../CosmicShore.Render/CosmicShore.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input.Sdl" Version="2.22.0" />
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.22.0" />
  </ItemGroup>

  <!-- The desktop player's core, shared verbatim: boot, the frame, the window passes, input, audio. -->
  <ItemGroup>
    <Compile Include="../CosmicShore.Player/PlayerWindow.cs" Link="Player/PlayerWindow.cs" />
    <Compile Include="../CosmicShore.Player/PlayerBoot.cs" Link="Player/PlayerBoot.cs" />
    <Compile Include="../CosmicShore.Player/PlayerAudio.cs" Link="Player/PlayerAudio.cs" />
    <Compile Include="../CosmicShore.Player/SilkInputBridge.cs" Link="Player/SilkInputBridge.cs" />
    <Compile Include="../CosmicShore.Player/InputScript.cs" Link="Player/InputScript.cs" />
    <Compile Include="../CosmicShore.Player/FrameRecorder.cs" Link="Player/FrameRecorder.cs" />
    <Compile Include="../CosmicShore.Player/Inspector.cs" Link="Player/Inspector.cs" />
    <Compile Include="../CosmicShore.Player/ScriptTicker.cs" Link="Player/ScriptTicker.cs" />
    <!-- PlayerWindow's control port and run report: on phones nothing starts them, so they stay inert. -->
    <Compile Include="../CosmicShore.Player/ControlServer.cs" Link="Player/ControlServer.cs" />
    <Compile Include="../CosmicShore.Player/SessionReport.cs" Link="Player/SessionReport.cs" />
    <Compile Include="../CosmicShore.Player/MarkerReport.cs" Link="Player/MarkerReport.cs" />
    <Compile Include="../CosmicShore.Player/UiDump.cs" Link="Player/UiDump.cs" />
    <Compile Include="../CosmicShore.Client/MiniPng.cs" Link="Player/MiniPng.cs" />
  </ItemGroup>

  <!-- Platform sources: each platform folder compiles only into its own target. -->
  <ItemGroup>
    <Compile Remove="Platforms/**" />
    <Compile Include="Platforms/Android/**/*.cs" Condition="$(TargetFramework.Contains('-android'))" />
    <Compile Include="Platforms/iOS/**/*.cs" Condition="$(TargetFramework.Contains('-ios'))" />
  </ItemGroup>

  <!-- ── Android: player data as APK assets, FMOD's .so per ABI and its Java half ── -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android')) and '$(CsDataPak)' != ''">
    <AndroidAsset Include="$(CsDataPak)/data.pak" Link="Assets/data.pak" />
    <AndroidAsset Include="$(CsDataPak)/data.hash" Link="Assets/data.hash" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android')) and '$(CsAppIcon)' != ''">
    <AndroidResource Include="$(CsAppIcon)" Link="Resources/mipmap/appicon.png" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-android')) and '$(CsFmodRoot)' != ''">
    <AndroidNativeLibrary Include="$(CsFmodRoot)/android/lib/arm64-v8a/libfmod.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(CsFmodRoot)/android/lib/arm64-v8a/libfmodstudio.so" Abi="arm64-v8a" />
    <AndroidNativeLibrary Include="$(CsFmodRoot)/android/lib/x86_64/libfmod.so" Abi="x86_64" Condition="Exists('$(CsFmodRoot)/android/lib/x86_64/libfmod.so')" />
    <AndroidNativeLibrary Include="$(CsFmodRoot)/android/lib/x86_64/libfmodstudio.so" Abi="x86_64" Condition="Exists('$(CsFmodRoot)/android/lib/x86_64/libfmodstudio.so')" />
    <AndroidLibrary Include="$(CsFmodRoot)/android/lib/fmod.jar" Bind="false" Condition="Exists('$(CsFmodRoot)/android/lib/fmod.jar')" />
  </ItemGroup>

  <!-- ── iOS: player data unpacked inside the bundle; FMOD linked statically (__Internal) ── -->
  <ItemGroup Condition="$(TargetFramework.Contains('-ios')) and '$(CsPlayerData)' != ''">
    <BundleResource Include="$(CsPlayerData)/**/*" LogicalName="Data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-ios')) and '$(CsFmodRoot)' != ''">
    <NativeReference Include="$(CsFmodRoot)/ios/lib/libfmodstudiounityplugin.a">
      <Kind>Static</Kind>
      <ForceLoad>true</ForceLoad>
      <Frameworks>AudioToolbox AVFoundation CoreAudio</Frameworks>
      <LinkerFlags>-lc++</LinkerFlags>
    </NativeReference>
  </ItemGroup>

</Project>
