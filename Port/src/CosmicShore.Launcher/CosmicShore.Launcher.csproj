<Project Sdk="Microsoft.NET.Sdk">
  <!-- Amoebius: the one shareable .exe for testing the engine. Picks a branch,
       fetches it, builds the player from that branch's own source and starts the game; also
       builds Android/iOS packages. Its UI is drawn with Dear ImGui on our own Silk.NET window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Amoebius</AssemblyName>
    <RootNamespace>CosmicShore.Launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Amoebius</Product>
    <Company>Froglet Inc.</Company>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.22.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <!-- Voice in the CLAUDE page: Windows' built-in speech recognition and synthesis (Microsoft's
         package; it compiles everywhere and is only called on Windows). -->
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Silk's loader does not probe runtimes/<rid>/native reliably for a framework-dependent run. -->
  <Target Name="CopySilkNativesBesideApp" AfterTargets="Build">
    <ItemGroup>
      <_SilkNatives Include="$(OutputPath)runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SilkNatives)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <Compile Include="../Shared/AmoebiusProjectSettings.cs" Link="Shared/AmoebiusProjectSettings.cs" />
    <Compile Include="../Shared/DccLocator.cs" Link="Shared/DccLocator.cs" />
  </ItemGroup>

  <!-- Upgrade path from the engine's earlier names: a launcher built as Prisma looks for
       Prisma(.exe) in what it publishes, and one from before that for FrogletLauncher(.exe).
       Leave a copy under each name so their UPDATE buttons can still install Amoebius;
       Amoebius's own updater deletes the copies. -->
  <Target Name="LegacyLauncherName" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)"
          DestinationFiles="$(PublishDir)Prisma$(_NativeExecutableExtension)" Condition="Exists('$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)')" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)"
          DestinationFiles="$(PublishDir)FrogletLauncher$(_NativeExecutableExtension)" Condition="Exists('$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)')" />
  </Target>

  <!-- The launcher's identity: the last commit that changed its source, and that commit's date.
       The UPDATE button compares it with the branch to say whether a newer launcher exists. A
       build from an exported source tree (the updater's own) passes both as properties. -->
  <Target Name="StampLauncherVersion" BeforeTargets="GetAssemblyAttributes;CoreGenerateAssemblyInfo">
    <Exec Condition="'$(LauncherCommit)' == ''" Command="git log -1 --format=%H -- ../CosmicShore.Launcher ../Shared"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="LauncherCommit" />
    </Exec>
    <Exec Condition="'$(LauncherDate)' == ''" Command="git log -1 --format=%cs -- ../CosmicShore.Launcher ../Shared"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="LauncherDate" />
    </Exec>
    <!-- Its source trees too (launcher, Shared, Directory.Build.props): a shallow clone can compare
         those with a branch without the history that finding the last commit needs. -->
    <Exec Condition="'$(LauncherTree)' == ''" Command="git rev-parse HEAD:./ HEAD:../Shared HEAD:../../Directory.Build.props"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="LauncherTree" />
    </Exec>
    <PropertyGroup>
      <LauncherTree>$(LauncherTree.Replace(';', '-'))</LauncherTree>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>LauncherTree</_Parameter1>
        <_Parameter2>$(LauncherTree)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>LauncherCommit</_Parameter1>
        <_Parameter2>$(LauncherCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>LauncherDate</_Parameter1>
        <_Parameter2>$(LauncherDate)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Include="../Shared/AmoebiusTracks.cs" Link="Shared/AmoebiusTracks.cs" />
    <Compile Include="../Shared/AmoebiusBoard.cs" Link="Shared/AmoebiusBoard.cs" />
    <Compile Include="../Shared/Workspace/*.cs" Link="Shared/Workspace/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
