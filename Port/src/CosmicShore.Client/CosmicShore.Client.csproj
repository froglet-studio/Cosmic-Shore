<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CosmicShore.Engine/CosmicShore.Engine.csproj" />
    <ProjectReference Include="../CosmicShore.Data/CosmicShore.Data.csproj" />
    <ProjectReference Include="../CosmicShore.Game/CosmicShore.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.22.0" />
    <!-- soft_oal natives — without this AudioEngine's AL.GetApi(soft: true) finds no
         device and the game runs silent (AudioEngine is fail-safe by design). -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <!-- Silk.NET's loader does not probe runtimes/<rid>/native/ reliably (verified on
       linux-x64 .NET 10: GlfwPlatform reports "not applicable" though the native is
       restored); it does find natives beside the app binary. Copy the building
       machine's RID natives flat into the output so `dotnet run` works everywhere.
       Published single-file builds are unaffected (IncludeNativeLibrariesForSelfExtract). -->
  <Target Name="CopySilkNativesBesideApp" AfterTargets="Build">
    <ItemGroup>
      <_SilkNatives Include="$(OutputPath)runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SilkNatives)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- Loaded via GetManifestResourceStream("CosmicShore.Client.Assets.squirrel.mesh") -->
    <EmbeddedResource Include="Assets/squirrel.mesh" />
  </ItemGroup>

</Project>
