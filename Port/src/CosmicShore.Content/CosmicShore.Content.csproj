<Project Sdk="Microsoft.NET.Sdk">

  <!-- Arc E — the content bridge. Reads the Unity project's own Assets/ tree
       (scenes, prefabs, .meta guids, textures, TMP fonts, materials, meshes) so the
       port renders the game's REAL content instead of hand-authored placeholders.
       Writes only on request: Yaml/UnityYamlFile (lossless round-trip) and
       Editing/UnityAssetEditor are the authoring path the AssetTool drives;
       loading content never writes anything. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CosmicShore.Engine/CosmicShore.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CosmicShore.Tests" />
    <InternalsVisibleTo Include="CosmicShore.Client" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/PrismaProjectSettings.cs" Link="Shared/PrismaProjectSettings.cs" />
  </ItemGroup>
</Project>
