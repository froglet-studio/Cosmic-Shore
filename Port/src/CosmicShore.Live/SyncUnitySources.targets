<Project>
  <!-- Copies the REAL Assets/_Scripts (runtime code: no Editor/ or Tests/ folders) into
       obj/live-src with the port's mechanical namespace substitutions applied (README
       "using-directive substitutions"), so the game compiles UNCHANGED against the port
       engine + CosmicShore.Compat. Never writes under Assets/. Incremental: a file is
       rewritten only when its transformed text differs. The namespace table is the ONE
       place a new substitution is added. -->
  <UsingTask TaskName="SyncUnitySources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDir ParameterType="System.String" Required="true" />
      <IncludeRoots ParameterType="System.String" Required="true" />
      <OutputDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Longest first; null = delete the using line.
        var map = new List<KeyValuePair<string, string>> {
          new("UnityEngine.Serialization", "CosmicShore.Engine.Serialization"),
          new("UnityEngine.Networking", "CosmicShore.Engine.Networking"),
          new("UnityEngine.UI", "CosmicShore.Engine.UI"),
          new("UnityEngine.EventSystems", "CosmicShore.Engine.UI"),
          new("UnityEngine.SceneManagement", "CosmicShore.Engine.SceneManagement"),
          new("UnityEngine.Events", "CosmicShore.Engine.Events"),
          new("UnityEngine.InputSystem", "CosmicShore.Engine.InputSystem"),
          new("UnityEngine.Rendering.Universal", "CosmicShore.Engine.Rendering"),
          new("UnityEngine.Rendering", "CosmicShore.Engine.Rendering"),
          new("UnityEngine.Profiling", "CosmicShore.Engine.Profiling"),
          new("UnityEngine.Pool", "CosmicShore.Engine.Pool"),
          new("UnityEngine.Assertions", "CosmicShore.Engine.Assertions"),
          new("UnityEngine.Audio", "CosmicShore.Engine.Audio"),
          new("UnityEngine", "CosmicShore.Engine"),
          new("TMPro", "CosmicShore.Engine.UI"),
          new("Obvious.Soap", "CosmicShore.Engine.Soap"),
          new("Unity.Netcode", "CosmicShore.Engine.Networking"),
          new("Unity.Services.Multiplayer", "CosmicShore.Engine.Networking"),
          new("Reflex.Attributes", "CosmicShore.Engine.Injection"),
          new("Reflex.Core", "CosmicShore.Engine.Injection"),
          new("Reflex.Injectors", "CosmicShore.Engine.Injection"),
          new("Reflex.Enums", "CosmicShore.Engine.Injection.Enums"),
          new("Unity.Collections", "CosmicShore.Engine.Collections"),
          new("Unity.Profiling", "CosmicShore.Engine.Profiling"),
          new("Unity.Services.Friends.Models", "CosmicShore.Engine.Services.Friends"),
          new("Unity.Services.Friends.Notifications", "CosmicShore.Engine.Services.Friends"),
          new("Unity.Services.Friends.Exceptions", "CosmicShore.Engine.Services.Friends"),
          new("Unity.Services.Leaderboards.Models", "CosmicShore.Engine.Services.Leaderboards"),
          new("Unity.Services.Leaderboards.Exceptions", "CosmicShore.Engine.Services.Leaderboards"),
          new("Unity.Services.Friends", "CosmicShore.Engine.Services.Friends"),
          new("Unity.Services.Leaderboards", "CosmicShore.Engine.Services.Leaderboards"),
          new("Unity.Services.CloudSave", "CosmicShore.Engine.Services"),
          new("Unity.Services.Analytics", "CosmicShore.Engine.Services.Analytics"),
          new("Unity.Services.Authentication", "CosmicShore.Engine.Services"),
          new("Unity.Services.Core", "CosmicShore.Engine.Services"),
          new("FMODUnity", "CosmicShore.Engine.Audio.Fmod"),
          new("FMOD.Studio", "CosmicShore.Engine.Audio.Fmod"),
          new("FMOD", "CosmicShore.Engine.Audio.Fmod"),
        };
        // A using of a SUB-namespace of a mapped root keeps its tail (Unity.Netcode.Components ->
        // CosmicShore.Engine.Networking.Components); exact matches take the table value.
        string MapNs(string ns) {
          foreach (var kv in map) {
            if (ns == kv.Key) return kv.Value ?? "";
            if (ns.StartsWith(kv.Key + ".") && kv.Value != null) return kv.Value + ns.Substring(kv.Key.Length);
          }
          return null;
        }
        var usingRx = new Regex(@"^([\s﻿]*)using\s+([A-Za-z_][\w.]*)\s*;", RegexOptions.Compiled);
        var qualified = map.Where(kv => kv.Value != null)
          .Select(kv => (rx: new Regex(@"(?<![\w.])" + Regex.Escape(kv.Key) + @"(?=\.)", RegexOptions.Compiled), to: kv.Value)).ToList();
        // A qualified reference into a DELETED namespace (UnityEngine.Serialization.FormerlySerializedAs)
        // resolves to the engine root, where those attributes live.
        qualified.Insert(0, (new Regex(@"(?<![\w.])UnityEngine\.Serialization(?=\.)", RegexOptions.Compiled), "CosmicShore.Engine"));

        // RPC interception: the IL post-processor's job. Every [ServerRpc]/[ClientRpc] body starts
        // with a call that routes the invocation over the network (NetRpc.Intercept) and returns when
        // the local body must not run. Expression bodies become blocks.
        var rpcAttrRx = new Regex(@"\[\s*(?:[\w.]+\.)?(ServerRpc|ClientRpc)\b[^\]\n]*\]", RegexOptions.Compiled);
        var rpcSigRx = new Regex(@"\G(?:\s|\[[^\]\n]*\]|//[^\n]*|/\*.*?\*/)*(?:(?:public|private|protected|internal|override|virtual|async|new|unsafe|sealed)\s+)*void\s+(\w+)\s*\(", RegexOptions.Compiled);
        int MatchClose(string t, int open, char o, char c) {
          int depth = 0;
          for (int i = open; i < t.Length; i++) {
            char ch = t[i];
            if (ch == '"') { i++; while (i < t.Length && t[i] != '"') { if (t[i] == '\\') i++; i++; } continue; }
            if (ch == '\'') { i++; while (i < t.Length && t[i] != '\'') { if (t[i] == '\\') i++; i++; } continue; }
            if (ch == o) depth++;
            else if (ch == c && --depth == 0) return i;
          }
          return -1;
        }
        List<string> SplitTop(string t) {
          var parts = new List<string>(); int depth = 0, start = 0;
          for (int i = 0; i < t.Length; i++) {
            char ch = t[i];
            if (ch == '(' || ch == '<' || ch == '[' || ch == '{') depth++;
            else if (ch == ')' || ch == '>' || ch == ']' || ch == '}') depth--;
            else if (ch == ',' && depth == 0) { parts.Add(t.Substring(start, i - start)); start = i + 1; }
          }
          if (t.Substring(start).Trim().Length > 0) parts.Add(t.Substring(start));
          return parts;
        }
        string ParamName(string p) {
          int eq = -1, depth = 0;
          for (int i = 0; i < p.Length; i++) {
            char ch = p[i];
            if (ch == '(' || ch == '<' || ch == '[') depth++;
            else if (ch == ')' || ch == '>' || ch == ']') depth--;
            else if (ch == '=' && depth == 0) { eq = i; break; }
          }
          var decl = (eq >= 0 ? p.Substring(0, eq) : p).Trim();
          var m = Regex.Match(decl, @"(@?\w+)\s*$");
          return m.Success ? m.Groups[1].Value : null;
        }
        string RewriteRpcs(string text) {
          var ms = rpcAttrRx.Matches(text);
          for (int k = ms.Count - 1; k >= 0; k--) {
            var am = ms[k];
            var sig = rpcSigRx.Match(text, am.Index + am.Length);
            if (!sig.Success) continue;
            string name = sig.Groups[1].Value;
            int open = sig.Index + sig.Length - 1;
            int close = MatchClose(text, open, '(', ')');
            if (close < 0) continue;
            var names = new List<string>();
            foreach (var part in SplitTop(text.Substring(open + 1, close - open - 1))) {
              var n = ParamName(part);
              if (n != null) names.Add(n);
            }
            string prologue = " if (global::CosmicShore.Engine.Networking.NetRpc.Intercept(this, \"" + name + "\", new object[] { " + string.Join(", ", names) + " })) return; ";
            int i = close + 1;
            while (i < text.Length && char.IsWhiteSpace(text[i])) i++;
            if (i < text.Length && text[i] == '{') {
              text = text.Insert(i + 1, prologue);
            } else if (i + 1 < text.Length && text[i] == '=' && text[i + 1] == '>') {
              int depth = 0, end = -1;
              for (int j = i + 2; j < text.Length; j++) {
                char ch = text[j];
                if (ch == '"') { j++; while (j < text.Length && text[j] != '"') { if (text[j] == '\\') j++; j++; } continue; }
                if (ch == '(' || ch == '{' || ch == '[') depth++;
                else if (ch == ')' || ch == '}' || ch == ']') depth--;
                else if (ch == ';' && depth == 0) { end = j; break; }
              }
              if (end < 0) continue;
              string expr = text.Substring(i + 2, end - (i + 2));
              text = text.Substring(0, i) + "{" + prologue + expr.Trim() + "; }" + text.Substring(end + 1);
            }
          }
          return text;
        }

        string Transform(string text) {
          var lines = text.Split('\n');
          for (int i = 0; i < lines.Length; i++) {
            var m = usingRx.Match(lines[i]);
            if (!m.Success) continue;
            var mapped = MapNs(m.Groups[2].Value);
            if (mapped == null) continue;
            var indent = m.Groups[1].Value.Replace("﻿", "");
            lines[i] = mapped.Length == 0 ? "" : indent + "using " + mapped + ";" + (lines[i].EndsWith("\r") ? "\r" : "");
          }
          text = string.Join("\n", lines);
          foreach (var (rx, to) in qualified) text = rx.Replace(text, to);
          if (text.Contains("Rpc")) text = RewriteRpcs(text);
          return text;
        }

        var src = Path.GetFullPath(SourceDir);
        var dst = Path.GetFullPath(OutputDir);
        var keep = new HashSet<string>(StringComparer.Ordinal);
        int written = 0, total = 0;
        var files = new List<string>();
        foreach (var root in IncludeRoots.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)) {
          var full = Path.Combine(src, root.Trim());
          if (File.Exists(full)) files.Add(full);
          else if (Directory.Exists(full)) files.AddRange(Directory.EnumerateFiles(full, "*.cs", SearchOption.AllDirectories));
          else Log.LogWarning($"SyncUnitySources: include root '{root}' not found under {src}");
        }
        foreach (var file in files) {
          var rel = file.Substring(src.TrimEnd(Path.DirectorySeparatorChar).Length + 1);
          var parts = rel.Split(Path.DirectorySeparatorChar);
          if (parts.Contains("Editor") || parts.Contains("Tests")) continue;
          total++;
          var outPath = Path.Combine(dst, rel);
          keep.Add(outPath);
          var text = Transform(File.ReadAllText(file));
          if (File.Exists(outPath) && File.ReadAllText(outPath) == text) continue;
          Directory.CreateDirectory(Path.GetDirectoryName(outPath));
          File.WriteAllText(outPath, text);
          written++;
        }
        if (Directory.Exists(dst))
          foreach (var stale in Directory.EnumerateFiles(dst, "*.cs", SearchOption.AllDirectories).Where(f => !keep.Contains(f)).ToList())
            File.Delete(stale);
        Log.LogMessage(MessageImportance.High, $"SyncUnitySources: {total} scripts, {written} rewritten");
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <!-- First-party RUNTIME script roots under Assets/ (vendored plugins are shimmed in CosmicShore.Compat instead). -->
    <LiveScriptRoots>_Scripts;FTUE;ArcadeDPadNav.cs;Resolvers</LiveScriptRoots>
    <!-- Which Unity project's Assets/ to compile. Default: this checkout's. Point it at another worktree
         (e.g. a bleeding-edge checkout) with -p:LiveAssetsDir=... and give it its own LiveSrcDir so two
         source trees never share one sync directory. -->
    <LiveAssetsDir Condition="'$(LiveAssetsDir)' == ''">$(MSBuildThisFileDirectory)../../../Assets</LiveAssetsDir>
    <LiveSrcDir Condition="'$(LiveSrcDir)' == ''">obj/live-src</LiveSrcDir>
  </PropertyGroup>

  <Target Name="SyncUnitySourcesBeforeBuild" BeforeTargets="BeforeBuild;CoreCompile;CollectPackageReferences">
    <SyncUnitySources SourceDir="$(LiveAssetsDir)" IncludeRoots="$(LiveScriptRoots)" OutputDir="$(MSBuildThisFileDirectory)$(LiveSrcDir)" />
    <ItemGroup>
      <Compile Remove="obj/live-src*/**/*.cs" />
      <Compile Include="$(LiveSrcDir)/**/*.cs" />
    </ItemGroup>
  </Target>
</Project>
