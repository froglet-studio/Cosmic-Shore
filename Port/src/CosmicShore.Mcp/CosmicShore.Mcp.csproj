<Project Sdk="Microsoft.NET.Sdk">
  <!-- amoebius-mcp: Amoebius's MCP server. Claude Code (the CLI, the desktop app, the
       launcher's CLAUDE page) talks to it over stdio to build and test the engine and to start,
       watch and drive a running player through its control port. No package dependencies:
       stdout carries only the protocol. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>amoebius-mcp</AssemblyName>
    <RootNamespace>CosmicShore.Mcp</RootNamespace>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/AmoebiusTracks.cs" Link="Shared/AmoebiusTracks.cs" />
    <Compile Include="../Shared/AmoebiusBoard.cs" Link="Shared/AmoebiusBoard.cs" />
    <Compile Include="../Shared/Workspace/*.cs" Link="Shared/Workspace/%(Filename)%(Extension)" />
    <Compile Include="../Shared/ParityDiff.cs" Link="Shared/ParityDiff.cs" />
    <Compile Include="../Shared/Bisect.cs" Link="Shared/Bisect.cs" />
    <Compile Include="../Shared/MultiplayerRun.cs" Link="Shared/MultiplayerRun.cs" />
  </ItemGroup>
</Project>
