<Project Sdk="Microsoft.NET.Sdk">

  <!-- Authoring from the command line: read, edit, create and delete objects in the Unity
       project's scenes, prefabs and assets, writing back only what changed. Depends on the
       content bridge plus the compiled game scripts (a new component's default fields come
       from its C# type); no renderer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>cs-asset</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CosmicShore.Content/CosmicShore.Content.csproj" />
    <!-- The game's own scripts, compiled against the engine: what a new component's
         default fields are read from. -->
    <ProjectReference Include="../CosmicShore.Live/CosmicShore.Live.csproj" />
    <ProjectReference Include="../CosmicShore.Compat/CosmicShore.Compat.csproj" />
  </ItemGroup>

</Project>
