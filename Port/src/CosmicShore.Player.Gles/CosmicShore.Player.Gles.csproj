<Project Sdk="Microsoft.NET.Sdk">
  <!-- The player on a DESKTOP OpenGL ES 3.2 context: the same sources as CosmicShore.Player,
       built with GLES against CosmicShore.Render.Gles. It exists to run the mobile render path
       on a workstation (or headlessly under xvfb + Mesa) before an APK is ever installed:
         dotnet run -c Release (project src/CosmicShore.Player.Gles) with the usual player arguments.
       Everything that differs from the desktop player is in GlProgram.ToEs and the #if GLES
       binding swaps; this project adds no code of its own. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <AssemblyName>CosmicShore</AssemblyName>
    <RootNamespace>CosmicShore.Player</RootNamespace>
    <DefineConstants>$(DefineConstants);GLES</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEVELOPMENT_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CosmicShore.Player/*.cs" LinkBase="Shared" />
    <Compile Include="../CosmicShore.Client/MiniPng.cs" Link="MiniPng.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CosmicShore.Engine/CosmicShore.Engine.csproj" />
    <ProjectReference Include="../CosmicShore.Compat/CosmicShore.Compat.csproj" />
    <ProjectReference Include="../CosmicShore.Live/CosmicShore.Live.csproj" />
    <ProjectReference Include="../CosmicShore.Content/CosmicShore.Content.csproj" />
    <ProjectReference Include="../CosmicShore.Render.Gles/CosmicShore.Render.Gles.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGLES" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.22.0" />
  </ItemGroup>
  <Target Name="CopySilkNativesBesideApp" AfterTargets="Build">
    <ItemGroup>
      <_SilkNatives Include="$(OutputPath)runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SilkNatives)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
