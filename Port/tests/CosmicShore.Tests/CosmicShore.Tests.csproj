<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test files use [Fact]/[Theory]/Assert unqualified without per-file usings. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/CosmicShore.Engine/CosmicShore.Engine.csproj" />
    <ProjectReference Include="../../src/CosmicShore.Data/CosmicShore.Data.csproj" />
    <ProjectReference Include="../../src/CosmicShore.Game/CosmicShore.Game.csproj" />
    <!-- Package-API shims (DOTweenShimTests exercises the DG.Tweening re-implementation). -->
    <ProjectReference Include="../../src/CosmicShore.Compat/CosmicShore.Compat.csproj" />
    <!-- Arc E: the content bridge reads the real Unity Assets/ tree. -->
    <ProjectReference Include="../../src/CosmicShore.Content/CosmicShore.Content.csproj" />
    <!-- port-m2: HeadlessRoundTests drives the CLI's HexRaceRound orchestration in-process. -->
    <ProjectReference Include="../../src/CosmicShore.Cli/CosmicShore.Cli.csproj" />
    <!-- Convergence rung 1: ClientConvergenceTests drives the SkimRace director in-process.
         The sim classes (SkimRaceSim.cs) are pure engine code — no Silk type is touched by
         the tests, so the Silk assemblies/natives that flow into the test output
         transitively are never loaded. -->
    <ProjectReference Include="../../src/CosmicShore.Client/CosmicShore.Client.csproj" />
    <!-- Mobile builds: the GL ES translation (Render) and the player-data packager (cs-build). -->
    <ProjectReference Include="../../src/CosmicShore.Render/CosmicShore.Render.csproj" />
    <ProjectReference Include="../../src/CosmicShore.Build/CosmicShore.Build.csproj" />
    <!-- Package-API shims (EntitiesShimTests exercises the Entities component store). -->
    <ProjectReference Include="../../src/CosmicShore.Compat/CosmicShore.Compat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prisma's run memory and board (linked into the launcher and the MCP server the same way). -->
    <Compile Include="../../src/Shared/PrismaTracks.cs" Link="Shared/PrismaTracks.cs" />
    <Compile Include="../../src/Shared/PrismaBoard.cs" Link="Shared/PrismaBoard.cs" />
    <!-- The BRANCHES page's rules and GitHub calls. -->
    <Compile Include="../../src/Shared/BranchCleanup.cs" Link="Shared/BranchCleanup.cs" />
  </ItemGroup>

</Project>
