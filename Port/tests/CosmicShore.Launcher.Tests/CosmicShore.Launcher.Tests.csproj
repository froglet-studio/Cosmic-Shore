<Project Sdk="Microsoft.NET.Sdk">
  <!-- Amoebius.exe's own logic that needs no window: chats and their persistence, plan usage,
       and the GIT page's git operations. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Same target as the launcher it references (its Windows build adds the Windows 10 target). -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(AmoebiusPlainTarget)' != 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CosmicShore.Launcher/CosmicShore.Launcher.csproj" />
  </ItemGroup>
</Project>
