<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Ported Unity-era code is not nullable-annotated; new engine code opts in per-file. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CS0649 ("field never assigned") fires on every [Inject]/[SerializeField] member;
         the Unity compiler suppressed it for serialized fields, so the port does too. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
</Project>
