+        /// <summary>
+        /// Press or release the commit drift on EVERY peer, the way a human press runs. The drift reshapes trail
+        /// prisms (Dolphin, Squirrel, Scarab) that each peer simulates itself, so a host-only press left clients
+        /// drawing a trail the host had already bent. Falls back to the local call offline.
+        /// </summary>
+        void PressCommitDrift(bool down)
+        {
+            var handler = VesselStatus?.ActionHandler;
+            if (handler != null)
+            {
+                if (down) handler.PerformShipControllerActionsReplicated(CommitControl);
+                else handler.StopShipControllerActionsReplicated(CommitControl);
+                return;
+            }
+            if (down) vessel?.PerformShipControllerActions(CommitControl);
+            else vessel?.StopShipControllerActions(CommitControl);
+        }
