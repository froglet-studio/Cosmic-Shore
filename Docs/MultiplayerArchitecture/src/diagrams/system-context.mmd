flowchart LR
  classDef ugs fill:#e9f7fa,stroke:#0c7f90,color:#08323a,stroke-width:1.1px;
  classDef net fill:#eef4fc,stroke:#3f5e8f,color:#13213f,stroke-width:1.1px;
  classDef svc fill:#f3f1fe,stroke:#5a40c9,color:#2a1f5c,stroke-width:1.1px;
  classDef accent fill:#0fa3b8,stroke:#0c7f90,color:#ffffff,stroke-width:1.1px;

  subgraph CL["Unity Client — per player"]
    direction TB
    app["Game / Menu_Main"]
    svc["Party · Presence · Friends<br/>services (SOAP)"]
    nm["Netcode<br/>NetworkManager"]
    app --> svc
    app --> nm
  end

  subgraph UGS["Unity Gaming Services — cloud"]
    direction TB
    auth["Authentication"]
    sess["Multiplayer Sessions"]
    lobby["Lobby"]
    relay["Relay"]
    friends["Friends"]
  end

  subgraph PEERS["Party peers"]
    direction TB
    pb["Client B"]
    pc["Client C"]
  end

  svc --> auth
  svc --> sess
  svc --> lobby
  svc --> friends
  sess -. provisions .-> relay
  nm <-->|UTP over Relay| relay
  relay <--> pb
  relay <--> pc

  class auth,sess,lobby,relay,friends ugs
  class nm net
  class svc svc
  class app accent
